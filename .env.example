# PostgreSQL connection string (keep this server-side; never expose it in browser code).
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

# Set true when your PostgreSQL provider requires TLS. Certificate validation stays enabled by default.
DATABASE_SSL=false
# Set false only when your provider uses a private/self-signed certificate and you understand the risk.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
PORT=3000
